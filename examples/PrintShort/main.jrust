public class PrintShort {
    public static void main(String[] args) {
        print("a");
        print("b");
        println();
        println("Hello, jrust!");
        println(1 + 2);
        int n = 7;
        println("n = " + n);
        println("{} + {} = {}", 1, 2, 3);
        println("literal braces: {{}} = {}", 42);
        System.out.println("System.out 的老写法仍可用");
    }
}
