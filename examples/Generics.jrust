// 示例：泛型类（class Box<T> → struct Box<T>）与泛型方法（<T> → fn id<T>）。
public class Box<T> {
    private T value;

    public Box(T value) {
        this.value = value;
    }

    public T get() {
        return this.value;
    }
}

// 类型参数没有被字段使用：产物用 PhantomData 占位。
public class Tag<T> {
}

public class Util {
    public <T> T identity(T x) {
        return x;
    }
}

public class Main {
    public static void main(String[] args) {
        Box<Integer> a = new Box<Integer>(42);
        println(a.get());

        // 钻石写法：类型参数由左侧声明推断。
        Box<String> b = new Box<>("hello");
        println(b.get() + "!");

        Tag<Integer> tag = new Tag<Integer>();

        Util u = new Util();
        println(u.identity(3) + u.identity(4));
        println(u.identity("ab"));
    }
}
