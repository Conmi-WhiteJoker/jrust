// 示例 4：赋值 = 按值复制，move = 转移所有权
// Java 的 `String b = a;` 是两个引用指向同一对象；
// jrust 的普通赋值生成 `a.clone()`，两个变量各持一份，互不影响；
// 想搬走所有权、不再保留源变量时，显式写 `move`。
public class Ownership {
    public static void main(String[] args) {
        String a = "hello";
        String b = move a;
        String c = "world";
        String d = c;
        System.out.println(b + " " + d);
        // 裸写法，输出同上
        println(b + " " + d);
    }
}
