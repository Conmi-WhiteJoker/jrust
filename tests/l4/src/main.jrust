import app.gate.Gate;
import app.store.Store;

/// L4 验收：async 中型服务全量转译（SPEC §15）。
///
/// 组成：多模块（`app.gate` / `app.store`）、外部 crate（axum / tokio）、
/// 共享状态（`Gate` 的 `@shared` 计数）、后台任务（`spawn` 周期心跳）。
/// HTTP 提取器、路由与信号处理属于外部 crate 类型，按 L2 边界写在 `raw` 里。
public class Main {
    raw {
        use std::sync::Arc;

        #[derive(Clone)]
        pub struct AppState {
            gate: Arc<Gate>,
            store: Arc<Store>,
        }

        pub fn build_app(state: AppState) -> axum::Router {
            axum::Router::new()
                .route("/health", axum::routing::get(health))
                .route("/login", axum::routing::post(login))
                .route("/devices/{id}", axum::routing::get(device))
                .route("/config/{key}", axum::routing::get(config))
                .route("/stats", axum::routing::get(stats))
                .with_state(state)
        }

        pub async fn health() -> &'static str {
            "ok"
        }

        pub async fn login(
            axum::extract::State(st): axum::extract::State<AppState>,
            body: String,
        ) -> (axum::http::StatusCode, String) {
            let pwd = body
                .trim()
                .strip_prefix("password=")
                .unwrap_or_default()
                .to_string();
            st.gate.touch();
            if st.gate.ok(pwd.as_str()) {
                (axum::http::StatusCode::OK, st.gate.token())
            } else {
                (axum::http::StatusCode::UNAUTHORIZED, st.gate.deny())
            }
        }

        pub async fn device(
            axum::extract::State(st): axum::extract::State<AppState>,
            axum::extract::Path(id): axum::extract::Path<String>,
        ) -> (axum::http::StatusCode, String) {
            st.gate.touch();
            if st.gate.known(id.as_str()) {
                (axum::http::StatusCode::OK, st.gate.device(id.as_str()))
            } else {
                (
                    axum::http::StatusCode::NOT_FOUND,
                    "deny:unknown-device".to_string(),
                )
            }
        }

        pub async fn config(
            axum::extract::State(st): axum::extract::State<AppState>,
            axum::extract::Path(key): axum::extract::Path<String>,
        ) -> (axum::http::StatusCode, String) {
            st.gate.touch();
            // 键缺失时 Store::get 会 panic（JR-E16）；这里把 panic 映射成 500，
            // 让失败路径也有稳定的状态码与响应体可比。
            let got = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
                st.store.get(key.as_str())
            }));
            match got {
                Ok(body) => (axum::http::StatusCode::OK, body),
                Err(_) => (
                    axum::http::StatusCode::INTERNAL_SERVER_ERROR,
                    "panic:missing-config-key".to_string(),
                ),
            }
        }

        pub async fn stats(
            axum::extract::State(st): axum::extract::State<AppState>,
        ) -> String {
            st.gate.stats()
        }
    }

    public static async void main(String[] args) {
        String portArg = raw { std::env::args().nth(1).unwrap_or_else(|| "18081".to_string()) };
        String addr = "127.0.0.1:" + portArg;

        Gate gate = Gate.create("s3cret");
        Store store = Store.demo();
        // 值语义赋值：bg 是 gate 的副本（`@shared` 字段是 Arc，两侧共享同一份计数）。
        Gate bg = gate;
        println("l4 service binding {}", addr);

        // 后台任务：每 100ms 递增 ticks。循环体含 `.await`，用 `raw` 直接写 Rust，
        // 这样既保留 jrust 的 `spawn`（产物是 tokio::spawn），又不用为 while(true) 消警告。
        spawn {
            raw {
                loop {
                    tokio::time::sleep(std::time::Duration::from_millis(100)).await;
                    bg.beat();
                }
            }
        }

        raw {
            let listener = tokio::net::TcpListener::bind(addr.as_str()).await.unwrap();
            println!("l4 service listening on {}", addr);
            let state = AppState {
                gate: std::sync::Arc::new(gate),
                store: std::sync::Arc::new(store),
            };
            axum::serve(listener, build_app(state))
                .with_graceful_shutdown(async {
                    let _ = tokio::signal::ctrl_c().await;
                })
                .await
                .unwrap();
            println!("l4 service shutdown clean");
        }
    }
}
