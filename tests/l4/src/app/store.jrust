package app.store;

/// L4 域逻辑：只读配置表。
///
/// `get` 走 jrust 的 `map.get` 语义（JR-E16）：键缺失时 `.cloned().unwrap()` 直接 panic。
/// 处理器用 `catch_unwind` 把 panic 映射成 500，于是 JR-G13 的「键缺失 panic 行为」
/// 在两条实现上都可观测、可对拍。
public class Store {
    private Map<String, String> config;

    public Store() {
        this.config = new HashMap<>();
    }

    public static Store demo() {
        Store s = new Store();
        s.put("region", "cn-north-1");
        s.put("plan", "team");
        return s;
    }

    public void put(String key, String value) {
        this.config.put(key, value);
    }

    /// 2.0 起 `Map.get` 返回 `V?`；本服务故意让缺键 panic（L4 的 JR-G13 失败路径
    /// 要求「键缺失 → 500」），所以这里显式解包而不是依赖隐式转换。
    public String get(String key) {
        String? found = this.config.get(key);
        return found;
    }
}
