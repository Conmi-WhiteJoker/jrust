// Set<T> / HashSet<T> → HashSet<T>（JR-T6）。
public class Main {
    public static void main(String[] args) {
        Set<Integer> nums = new HashSet<>();
        nums.add(1);
        nums.add(2);
        nums.add(1);
        println(nums.size());
        println(nums.contains(2));
        nums.remove(1);
        println(nums.size());
        println(nums.contains(1));

        Set<String> names = new HashSet<>();
        names.add("jrust");
        println(names.contains("jrust"));
        println(names.isEmpty());
    }
}
