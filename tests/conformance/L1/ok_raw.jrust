// raw 内联：成员 / 语句 / 表达式三处原样输出（JR-X1）。
public class Main {
    raw {
        fn raw_helper(x: i32) -> i32 {
            x * 3
        }
    }

    public static void main(String[] args) {
        raw {
            println!("raw 语句: {}", raw_helper(4));
        }
        int y = raw { 5 + 6 };
        println(y);
        String s = raw { format!("raw-{}", "expr") };
        println(s);
    }
}
