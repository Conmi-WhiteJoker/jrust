/// String 方法映射（阶段 D / JR-E20）：只做语义等价的 Java → Rust 换名。
public class Main {
    public static void main(String[] args) {
        String s = "  Hello  ";
        println(s.length());
        println(s.trim());
        println(s.trim().toLowerCase());
        println(s.trim().toUpperCase());
        println(s.trim().isEmpty());
        println(s.trim().startsWith("He"));
        println(s.trim().endsWith("lo"));
        println(s.trim().contains("ell"));
        println(s.trim().equals("Hello"));
        println(s.trim().toString());
    }
}
