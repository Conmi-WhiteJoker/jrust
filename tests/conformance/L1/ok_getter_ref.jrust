public class Person {
    private String name;
    private int age;

    public Person(String name, int age) {
        this.name = name;
        this.age = age;
    }

    public String name() {
        return this.name;
    }

    public int age() {
        return this.age;
    }
}

public class Main {
    public static void main(String[] args) {
        Person p = new Person("Ann", 30);
        println("{} {}", p.name(), p.age());
        String n = p.name();
        println(n);
        println(p.name() + "!");
    }
}
