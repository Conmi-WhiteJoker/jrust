public class Main {
    public static void main(String[] args) {
        int total = 0;
        for (int i = 0; i < 5; i++) {
            total += i;
        }
        println(total);

        for (int i = 1; i <= 3; i += 1) {
            print(i);
        }
        println();

        for (int i = 3; i > 0; i--) {
            print(i);
        }
        println();

        for (int i = 2; i >= 0; i -= 1) {
            print(i);
        }
        println();

        int n = 3;
        for (int k = n; k < n + 2; k += 1) {
            print(k);
        }
        println();

        int hits = 0;
        for (int i = 0; i < 10; i++) {
            if (i == 3) {
                continue;
            }
            if (i == 6) {
                break;
            }
            hits += 1;
        }
        println(hits);
    }
}
