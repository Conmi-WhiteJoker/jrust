public class Main {
    public static void main(String[] args) {
        String a = "n=";
        int n = 3;
        String s = a + n;
        println(s);

        String t = "a" + "b";
        println(t);

        String u = "x" + 1 + true;
        println(u);

        String[] arr = new String[1];
        arr[0] = "v" + 2;
        println(arr[0]);
    }
}
